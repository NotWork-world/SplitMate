# Copy to server/.env for local development. Placeholders only — never commit real values.
SPLITMATE_ENV=development
# Local: SQLite works out of the box. Production: your Neon connection string.
SPLITMATE_DATABASE_URL=sqlite:///./splitmate.db
# SPLITMATE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SPLITMATE_JWT_SECRET=replace-me
SPLITMATE_SIGNING_SECRET=replace-me

# Google Sign-In: the *Web application* OAuth client ID (comma-separate several).
SPLITMATE_GOOGLE_CLIENT_IDS=

# Bill photos are deleted once the bill is finalised, so local disk is fine everywhere.
# Use s3 (e.g. Cloudflare R2) only if you decide to keep photos.
SPLITMATE_STORAGE_BACKEND=local
SPLITMATE_STORAGE_DIR=./storage
SPLITMATE_S3_BUCKET=
SPLITMATE_S3_ENDPOINT_URL=
SPLITMATE_S3_ACCESS_KEY_ID=
SPLITMATE_S3_SECRET_ACCESS_KEY=

SPLITMATE_PUBLIC_BASE_URL=http://localhost:8000

# Phone notifications: Firebase service-account JSON (one line) or its base64. Empty = in-app only.
SPLITMATE_FIREBASE_CREDENTIALS=
